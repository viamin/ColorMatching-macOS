{
  "format": "color-matching-solver-parity/1",
  "provenance": {
    "generator": "seed",
    "source": "hand-derived from the documented Elixir ColorMatching.WeightedSquaredError semantics: the module doctest (score 0.205), the missing-measurement exclusion policy (a color missing a measurement for any active channel is excluded, never treated as zero brightness), and the IlluminantMatching.best_match/4 earliest-wins tie policy",
    "note": "Seed corpus standing in until the parity corpus generated by viamin/color_matching#111 is vendored into this directory in the same format. Refresh instructions: docs/solver-parity-corpus.md"
  },
  "cases": [
    {
      "id": "elixir-doctest-weights",
      "description": "The Elixir WeightedSquaredError doctest vectors as a selection: candidate 101 reproduces the documented 0.205 score and wins over two far candidates.",
      "weights": { "white": 0.5, "red": 1.0, "green": 1.0, "blue": 0.0, "lps": 1.5 },
      "palette": [
        { "id": 101, "name": "Doctest Candidate", "hex": "#803020",
          "responses": { "white": 0.5, "red": 0.1, "green": 0.4, "blue": 0.0, "lps": 0.3 } },
        { "id": 102, "name": "Far Dark", "hex": "#202020",
          "responses": { "white": 0.0, "red": 0.9, "green": 0.0, "lps": 0.0 } },
        { "id": 103, "name": "Far Bright", "hex": "#E0E0E0",
          "responses": { "white": 1.0, "red": 1.0, "green": 1.0, "lps": 1.0 } }
      ],
      "target": { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.1, "lps": 0.5 },
      "expected": { "selected_id": 101, "score": 0.205 }
    },
    {
      "id": "exact-match-scores-zero",
      "description": "A candidate whose response vector equals the target wins with score 0.",
      "weights": { "red": 1.0, "green": 1.0 },
      "palette": [
        { "id": 201, "name": "Exact", "hex": "#307030",
          "responses": { "red": 0.3, "green": 0.7 } },
        { "id": 202, "name": "Near Miss", "hex": "#406040",
          "responses": { "red": 0.4, "green": 0.6 } }
      ],
      "target": { "red": 0.3, "green": 0.7 },
      "expected": { "selected_id": 201, "score": 0.0 }
    },
    {
      "id": "tie-selects-earliest-palette-entry",
      "description": "Candidates 301 and 302 carry identical measurements (0.01 each); the earliest palette entry wins the tie. This pins the deterministic tie policy shared with Elixir best_match/4.",
      "weights": { "white": 1.0 },
      "palette": [
        { "id": 301, "name": "Tied First", "hex": "#807060",
          "responses": { "white": 0.5 } },
        { "id": 302, "name": "Tied Second", "hex": "#705F4E",
          "responses": { "white": 0.5 } },
        { "id": 303, "name": "Far", "hex": "#E6E6FA",
          "responses": { "white": 0.9 } }
      ],
      "target": { "white": 0.4 },
      "expected": { "selected_id": 301, "score": 0.01, "tied_ids": [301, 302] }
    },
    {
      "id": "missing-measurement-excluded-not-zero",
      "description": "Candidate 401 matches red exactly but is unmeasured on green (an active channel), so it is excluded rather than scored as green=0; the fully measured 402 wins. If missing were treated as zero brightness, 401 would score 0.16 and win — this case fails under that defect.",
      "weights": { "red": 1.0, "green": 1.0 },
      "palette": [
        { "id": 401, "name": "Unmeasured Green", "hex": "#331A00",
          "responses": { "red": 0.2 } },
        { "id": 402, "name": "Fully Measured", "hex": "#E6C35C",
          "responses": { "red": 0.9, "green": 0.9 } }
      ],
      "target": { "red": 0.2, "green": 0.4 },
      "expected": { "selected_id": 402, "score": 0.74 }
    },
    {
      "id": "measured-zero-brightness-is-selectable",
      "description": "A measured 0.0 brightness is a real value, not a missing one: candidate 501 is selectable and wins a dark target exactly.",
      "weights": { "white": 1.0 },
      "palette": [
        { "id": 501, "name": "Measured Black", "hex": "#050505",
          "responses": { "white": 0.0 } },
        { "id": 502, "name": "Near Black", "hex": "#1A1A1A",
          "responses": { "white": 0.1 } }
      ],
      "target": { "white": 0.0 },
      "expected": { "selected_id": 501, "score": 0.0 }
    },
    {
      "id": "zero-weight-channel-missing-does-not-exclude",
