{
  "openapi": "3.0.3",
  "info": {
    "title": "Color Matching API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/printer_profiles": {
      "get": {
        "tags": [
          "Palettes"
        ],
        "summary": "List printer profiles",
        "operationId": "ColorPaletteController.printer_profiles",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Printer profiles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrinterProfilesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/printer_profiles/{printer_profile_id}/colors": {
      "get": {
        "tags": [
          "Palettes"
        ],
        "summary": "List profile colors",
        "operationId": "ColorPaletteController.profile_colors",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "printer_profile_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile colors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileColorsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid printer profile ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Printer profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid printer profile ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/printer_profiles/{printer_profile_id}/metamer_pairs": {
      "get": {
        "tags": [
          "Palettes"
        ],
        "summary": "List confirmed metamer pairs",
        "operationId": "ColorPaletteController.metamer_pairs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "printer_profile_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metamer pairs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetamerPairsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid printer profile ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Printer profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid printer profile ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/palettes": {
      "get": {
        "tags": [
          "Palettes"
        ],
        "summary": "List palettes",
        "operationId": "ColorPaletteController.palettes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Palettes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PalettesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/colors": {
      "get": {
        "tags": [
          "Palettes"
        ],
        "summary": "List palette colors and illuminant responses",
        "operationId": "ColorPaletteController.colors",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "printer_profile_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          {
            "name": "palette_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Colors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ColorsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid palette or printer profile ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Palette or printer profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API token"
      }
    },
    "schemas": {
      "ApiErrorResponse": {
        "title": "ApiErrorResponse",
        "type": "object",
        "properties": {
          "errors": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "pointer": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "pointer"
                      ]
                    }
                  },
                  "required": [
                    "detail",
                    "source"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "errors"
        ]
      },
      "PrinterProfile": {
        "title": "PrinterProfile",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "printer_make_model": {
            "type": "string"
          },
          "paper_type": {
            "type": "string"
          },
          "ink_type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "printer_make_model",
          "paper_type",
          "ink_type"
        ]
      },
      "Rgb": {
        "title": "Rgb",
        "type": "object",
        "properties": {
          "r": {
            "type": "integer"
          },
          "g": {
            "type": "integer"
          },
          "b": {
            "type": "integer"
          }
        },
        "required": [
          "r",
          "g",
          "b"
        ]
      },
      "PrinterProfilesResponse": {
        "title": "PrinterProfilesResponse",
        "type": "object",
        "properties": {
          "printer_profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrinterProfile"
            }
          }
        },
        "required": [
          "printer_profiles"
        ]
      },
      "PalettesResponse": {
        "title": "PalettesResponse",
        "type": "object",
        "properties": {
          "palettes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "is_preset": {
                  "type": "boolean"
                },
                "color_count": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name",
                "is_preset",
                "color_count"
              ]
            }
          }
        },
        "required": [
          "palettes"
        ]
      },
      "ProfileColorsResponse": {
        "title": "ProfileColorsResponse",
        "type": "object",
        "properties": {
          "printer_profile": {
            "$ref": "#/components/schemas/PrinterProfile"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "hex": {
                  "type": "string"
                },
                "rgb": {
                  "$ref": "#/components/schemas/Rgb"
                },
                "responses": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "name",
                "hex",
                "responses"
              ]
            }
          }
        },
        "required": [
          "printer_profile",
          "colors"
        ]
      },
      "ColorsResponse": {
        "title": "ColorsResponse",
        "type": "object",
        "properties": {
          "printer_profile": {
            "$ref": "#/components/schemas/PrinterProfile"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "hex": {
                  "type": "string"
                },
                "rgb": {
                  "$ref": "#/components/schemas/Rgb"
                },
                "palette_id": {
                  "type": "integer"
                },
                "palette_name": {
                  "type": "string",
                  "nullable": true
                },
                "sort_order": {
                  "type": "integer"
                },
                "responses": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "id",
                "name",
                "hex",
                "palette_id",
                "sort_order",
                "responses"
              ]
            }
          }
        },
        "required": [
          "printer_profile",
          "colors"
        ]
      },
      "MetamerPairsResponse": {
        "title": "MetamerPairsResponse",
        "type": "object",
        "properties": {
          "printer_profile": {
            "$ref": "#/components/schemas/PrinterProfile"
          },
          "metamer_pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pair_id": {
                  "type": "string"
                },
                "color_a_hex": {
                  "type": "string"
                },
                "color_b_hex": {
                  "type": "string"
                },
                "illuminant": {
                  "type": "string"
                },
                "classification": {
                  "type": "string"
                },
                "notes": {
                  "type": "string",
                  "nullable": true
                },
                "classified_at": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                }
              },
              "required": [
                "pair_id",
                "color_a_hex",
                "color_b_hex",
                "illuminant",
                "classification"
              ]
            }
          }
        },
        "required": [
          "printer_profile",
          "metamer_pairs"
        ]
      }
    }
  }
}
