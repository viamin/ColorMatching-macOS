      "id": "elixir-doctest-weighted-squared-error",
      "description": "Mirrors the Elixir WeightedSquaredError doctest: expected score 0.205 with weights white 0.5, red 1.0, green 1.0, blue 0.0, lps 1.5. Blue has weight zero, so its value never contributes. The candidate missing the active lps measurement is excluded.",
      "tags": ["doctest", "exclusion", "zero-weight"],
      "weights": { "white": 0.5, "red": 1.0, "green": 1.0, "blue": 0.0, "lps": 1.5 },
      "palette": [
        { "id": 101, "name": "Doctest Candidate", "hex": "#C64A35", "rgb": { "r": 198, "g": 74, "b": 53 },
          "responses": { "white": { "brightness": 0.5 }, "red": { "brightness": 0.1 }, "green": { "brightness": 0.4 }, "blue": { "brightness": 0.0 }, "lps": { "brightness": 0.3 } } },
        { "id": 102, "name": "Far Gray", "hex": "#888888",
          "responses": { "white": { "brightness": 0.1 }, "red": { "brightness": 0.9 }, "green": { "brightness": 0.1 }, "blue": { "brightness": 0.5 }, "lps": { "brightness": 0.9 } } },
        { "id": 103, "name": "Missing LPS", "hex": "#FF0000",
          "responses": { "white": { "brightness": 0.4 }, "red": { "brightness": 0.15 }, "green": { "brightness": 0.35 }, "blue": { "brightness": 0.1 } } }
      ],
      "targets": [ { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.1, "lps": 0.5 } ],
      "expected_selections": [101],
      "expected_scores": [0.205],
      "expected_excluded_count": 1
