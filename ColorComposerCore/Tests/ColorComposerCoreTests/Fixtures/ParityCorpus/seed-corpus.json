{
  "version": 1,
  "scorer": "WeightedSquaredError",
  "source": "Hand-computed seed corpus pinning the consumption format for ColorComposerCore's SolverParityCorpusTests (issue #39). Selections follow the documented solver semantics: lowest weighted squared error wins, ties resolve to the earliest candidate in array order (mirroring Elixir IllumitantMatching.best_match/4). The canonical corpus generated by the Elixir service lands alongside this file as weighted-squared-error-corpus.json (viamin/color_matching#111).",
  "cases": [
    {
      "id": "elixir-doctest-value-parity",
      "description": "Mirrors the Elixir WeightedSquaredError doctest exactly; expected score 0.205. Blue weight is zero so its presence on candidate and target is ignored.",
      "weights": { "white": 0.5, "red": 1.0, "green": 1.0, "blue": 0.0, "lps": 1.5 },
      "target": { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.1, "lps": 0.5 },
      "candidates": [
        { "id": 1, "responses": { "white": 0.5, "red": 0.1, "green": 0.4, "blue": 0.0, "lps": 0.3 } }
      ],
      "expected": { "selected_id": 1, "score": 0.205 }
    },
    {
      "id": "exact-match-wins-over-near-miss",
      "description": "An exact response-vector match scores zero and beats near misses scoring 0.02.",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "candidates": [
        { "id": 1, "responses": { "red": 0.6, "green": 0.4 } },
        { "id": 2, "responses": { "red": 0.5, "green": 0.5 } },
        { "id": 3, "responses": { "red": 0.4, "green": 0.6 } }
      ],
      "expected": { "selected_id": 2, "score": 0.0 }
    },
    {
      "id": "tie-resolves-to-earliest-position-not-lowest-id",
      "description": "Candidates 9 and 4 tie at 0.01. The earliest candidate in array order (9) must win even though its id is not the lowest — parity is with input position, not id ordering.",
      "weights": { "red": 1.0 },
      "target": { "red": 0.5 },
      "candidates": [
        { "id": 9, "responses": { "red": 0.4 } },
        { "id": 4, "responses": { "red": 0.6 } },
        { "id": 2, "responses": { "red": 0.7 } }
      ],
      "expected": { "selected_id": 9, "score": 0.01, "tie": true }
    },
    {
      "id": "tie-two-channel-symmetric-earliest-wins",
      "description": "Mirror-symmetric candidates 2 and 5 both score 0.02; the earlier one (2) wins. Candidate 8 scores 0.25.",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "candidates": [
        { "id": 2, "responses": { "red": 0.4, "green": 0.6 } },
        { "id": 5, "responses": { "red": 0.6, "green": 0.4 } },
        { "id": 8, "responses": { "red": 0.5, "green": 0.0 } }
      ],
      "expected": { "selected_id": 2, "score": 0.02, "tie": true }
    },
    {
      "id": "excluded-candidate-never-wins",
      "description": "Candidate 1 lacks the required green measurement, so it is excluded despite a close red value; candidate 2 wins with 0.02.",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "candidates": [
        { "id": 1, "responses": { "red": 0.9 } },
        { "id": 2, "responses": { "red": 0.4, "green": 0.4 } }
      ],
      "expected": { "selected_id": 2, "score": 0.02, "excluded_ids": [1] }
    },
    {
      "id": "all-candidates-excluded-when-each-misses-a-required-channel",
      "description": "Every candidate is missing at least one required measurement, so no selection exists.",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "candidates": [
        { "id": 1, "responses": { "red": 0.5 } },
        { "id": 2, "responses": { "green": 0.5 } }
      ],
      "expected": { "selected_id": null, "excluded_ids": [1, 2] }
    },
    {
      "id": "target-missing-required-channel-excludes-every-candidate",
      "description": "The target vector has no green value, so every candidate is excluded even when fully measured.",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5 },
      "candidates": [
        { "id": 1, "responses": { "red": 0.5, "green": 0.5 } }
      ],
      "expected": { "selected_id": null, "excluded_ids": [1] }
    },
    {
      "id": "zero-weight-channels-are-ignored",
      "description": "Only white carries a positive weight; the candidate has no other measurements and must not be excluded. Expected score (0.8-0.5)^2 = 0.09.",
      "weights": { "white": 1.0 },
      "target": { "white": 0.8 },
      "candidates": [
        { "id": 1, "responses": { "white": 0.5 } }
      ],
      "expected": { "selected_id": 1, "score": 0.09 }
    },
    {
      "id": "channel-weight-scales-squared-error",
      "description": "Both channels differ by 1.0; a 10x weight on white yields 10*1 + 1*1 = 11.",
      "weights": { "white": 10.0, "red": 1.0 },
      "target": { "white": 1.0, "red": 0.0 },
      "candidates": [
        { "id": 1, "responses": { "white": 0.0, "red": 1.0 } }
      ],
      "expected": { "selected_id": 1, "score": 11.0 }
    },
    {
      "id": "lps-and-white-exact-match-not-first-wins",
      "description": "Candidates 4 and 6 both score 0.02 under {lps: 1.5, white: 0.5}; the exact match (11) is not first in the palette and still wins with 0.",
      "weights": { "lps": 1.5, "white": 0.5 },
      "target": { "lps": 0.4, "white": 0.6 },
      "candidates": [
        { "id": 4, "responses": { "lps": 0.5, "white": 0.5 } },
        { "id": 11, "responses": { "lps": 0.4, "white": 0.6 } },
        { "id": 6, "responses": { "lps": 0.3, "white": 0.7 } }
      ],
      "expected": { "selected_id": 11, "score": 0.0 }
    }
  ]
}
