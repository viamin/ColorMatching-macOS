{
  "schema_version": 1,
  "source": "https://github.com/viamin/color_matching/pull/111",
  "cases": [
    {
      "name": "exact match selects the matching candidate",
      "weights": { "red": 1.0 },
      "target": { "red": 0.5 },
      "palette": [
        { "id": 101, "responses": { "red": 0.5 } },
        { "id": 102, "responses": { "red": 0.6 } }
      ],
      "expected": { "selected_color_id": 101, "score": 0.0, "excluded_color_ids": [] }
    },
    {
      "name": "channel weights choose the lower weighted error",
      "weights": { "red": 4.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "palette": [
        { "id": 201, "responses": { "red": 0.4, "green": 0.5 } },
        { "id": 202, "responses": { "red": 0.5, "green": 0.3 } }
      ],
      "expected": { "selected_color_id": 202, "score": 0.04, "excluded_color_ids": [] }
    },
    {
      "name": "zero weight channels do not require measurements",
      "weights": { "red": 1.0, "blue": 0.0 },
      "target": { "red": 0.4, "blue": 0.9 },
      "palette": [
        { "id": 301, "responses": { "red": 0.4 } },
        { "id": 302, "responses": { "red": 0.6, "blue": 0.9 } }
      ],
      "expected": { "selected_color_id": 301, "score": 0.0, "excluded_color_ids": [] }
    },
    {
      "name": "missing required measurements are excluded",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "palette": [
        { "id": 401, "responses": { "red": 0.5 } },
        { "id": 402, "responses": { "red": 0.7, "green": 0.5 } }
      ],
      "expected": { "selected_color_id": 402, "score": 0.04, "excluded_color_ids": [401] }
    },
    {
      "name": "ties retain the earliest palette candidate",
      "weights": { "red": 1.0 },
      "target": { "red": 0.5 },
      "palette": [
        { "id": 501, "responses": { "red": 0.4 } },
        { "id": 502, "responses": { "red": 0.6 } }
      ],
      "expected": { "selected_color_id": 501, "score": 0.01, "excluded_color_ids": [] }
    }
  ]
}
