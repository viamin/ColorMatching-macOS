      "weights": { "red": 1.0 },
      "target": { "red": 0.5 },
      "expected": { "selection_index": 0, "score": 0.0, "tie": true, "excluded_candidates": 0 }
    },
    {
      "id": "tie-within-pair-beats-outlier",
      "description": "The tying pair sits later in palette order; the outlier loses and the earlier member of the pair wins.",
      "palette": [
        { "id": 51, "hex": "#100000", "responses": { "red": 0.2 } },
        { "id": 52, "hex": "#200000", "responses": { "red": 0.5 } },
