        { "id": 61, "hex": "#001111", "responses": { "white": 0.0, "red": 1.0 } },
        { "id": 62, "hex": "#111100", "responses": { "white": 1.0, "red": 0.0 } }
      ],
      "weights": { "white": 1.0, "red": 1.0 },
      "target": { "white": 0.5, "red": 0.5 },
      "expected": { "selection_index": 0, "score": 0.5, "tie": true, "excluded_candidates": 0 }
    },
    {
      "id": "weight-flip-white-heavy",
      "description": "Equal weights favor the candidate that is closer on white (exact match) despite its larger red error.",
      "palette": [
        { "id": 71, "hex": "#101010", "responses": { "white": 0.5, "red": 0.9 } },
        { "id": 72, "hex": "#202020", "responses": { "white": 0.0, "red": 0.5 } }
      ],
      "weights": { "white": 1.0, "red": 1.0 },
      "target": { "white": 0.5, "red": 0.5 },
      "expected": { "selection_index": 0, "score": 0.16, "tie": false, "excluded_candidates": 0 }
    },
    {
      "id": "weight-flip-red-heavy",
      "description": "The same palette and target as weight-flip-white-heavy, but with white weight 0.1 the selection flips to the red-exact candidate — weights change the winner.",
      "palette": [
        { "id": 71, "hex": "#101010", "responses": { "white": 0.5, "red": 0.9 } },
        { "id": 72, "hex": "#202020", "responses": { "white": 0.0, "red": 0.5 } }
      ],
      "weights": { "white": 0.1, "red": 1.0 },
      "target": { "white": 0.5, "red": 0.5 },
      "expected": { "selection_index": 1, "score": 0.025, "tie": false, "excluded_candidates": 0 }
    },
    {
      "id": "all-candidates-excluded-unmatched",
      "description": "Every candidate is missing the required green measurement, so nothing is selectable and the cell stays unmatched.",
      "palette": [
        { "id": 81, "hex": "#400000", "responses": { "red": 0.5 } },
