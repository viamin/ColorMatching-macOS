{
  "source": "viamin/color_matching#111",
  "refresh": "Replace this file with the corpus committed by viamin/color_matching#111; preserve the schema consumed by SolverParityCorpusTests.",
  "cases": [
    {
      "name": "exact match selects matching palette color",
      "weights": { "red": 1.0 },
      "target": { "red": 0.4 },
      "palette": [
        { "id": 101, "hex": "#111111", "responses": { "red": 0.1 } },
        { "id": 102, "hex": "#444444", "responses": { "red": 0.4 } }
      ],
      "expected": { "palette_id": 102, "error": 0.0, "excluded_candidate_count": 0 }
    },
    {
      "name": "ties select the earliest palette candidate",
      "weights": { "red": 1.0 },
      "target": { "red": 0.5 },
      "palette": [
        { "id": 201, "hex": "#111111", "responses": { "red": 0.4 } },
        { "id": 202, "hex": "#222222", "responses": { "red": 0.6 } }
      ],
      "expected": { "palette_id": 201, "error": 0.01, "excluded_candidate_count": 0 }
    },
    {
      "name": "missing active response excludes candidate",
      "weights": { "red": 1.0, "green": 2.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "palette": [
        { "id": 301, "hex": "#111111", "responses": { "red": 0.5 } },
        { "id": 302, "hex": "#222222", "responses": { "red": 0.5, "green": 0.5 } }
      ],
      "expected": { "palette_id": 302, "error": 0.0, "excluded_candidate_count": 1 }
    },
    {
      "name": "zero-weight channels neither contribute nor exclude",
      "weights": { "red": 1.0, "green": 0.0 },
      "target": { "red": 0.25, "green": 1.0 },
      "palette": [
        { "id": 401, "hex": "#111111", "responses": { "red": 0.25 } },
        { "id": 402, "hex": "#222222", "responses": { "red": 0.3, "green": 1.0 } }
      ],
      "expected": { "palette_id": 401, "error": 0.0, "excluded_candidate_count": 0 }
    },
    {
      "name": "channel weights determine the selected color",
      "weights": { "red": 4.0, "green": 1.0 },
      "target": { "red": 0.0, "green": 0.0 },
      "palette": [
        { "id": 501, "hex": "#111111", "responses": { "red": 0.1, "green": 0.5 } },
        { "id": 502, "hex": "#222222", "responses": { "red": 0.3, "green": 0.0 } }
      ],
      "expected": { "palette_id": 501, "error": 0.29, "excluded_candidate_count": 0 }
    },
    {
      "name": "all candidates excluded leaves the cell unmatched",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "palette": [
        { "id": 601, "hex": "#111111", "responses": { "red": 0.5 } }
      ],
      "expected": { "palette_id": null, "error": "infinity", "excluded_candidate_count": 1 }
    }
  ]
}
