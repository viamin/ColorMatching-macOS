{
  "format": "color_matching.weighted_squared_error.parity.v1",
  "source": "https://github.com/viamin/color_matching/pull/111",
  "source_revision": "pending upstream corpus access",
  "cases": [
    {
      "name": "weighted multi-channel selection",
      "weights": { "white": 0.5, "red": 1.0, "green": 1.0, "blue": 0.0, "lps": 1.5 },
      "target": { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.1, "lps": 0.5 },
      "candidates": [
        { "id": 1, "responses": { "white": 0.5, "red": 0.1, "green": 0.4, "blue": 0.0, "lps": 0.3 } },
        { "id": 2, "responses": { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.9, "lps": 0.5 } }
      ],
      "expected": { "selected_id": 2, "score": 0.0, "excluded_candidate_ids": [] }
    },
    {
      "name": "earliest candidate wins an exact tie",
      "weights": { "red": 1.0 },
      "target": { "red": 0.5 },
      "candidates": [
        { "id": 9, "responses": { "red": 0.4 } },
        { "id": 3, "responses": { "red": 0.6 } }
      ],
      "expected": { "selected_id": 9, "score": 0.01, "excluded_candidate_ids": [] }
    },
    {
      "name": "missing active response is excluded",
      "weights": { "red": 1.0, "green": 2.0 },
      "target": { "red": 0.5, "green": 0.2 },
      "candidates": [
        { "id": 7, "responses": { "red": 0.5 } },
        { "id": 8, "responses": { "red": 0.5, "green": 0.3 } }
      ],
      "expected": { "selected_id": 8, "score": 0.02, "excluded_candidate_ids": [7] }
    },
    {
      "name": "zero-weight missing response remains eligible",
      "weights": { "red": 1.0, "green": 0.0 },
      "target": { "red": 0.7, "green": 0.2 },
      "candidates": [
        { "id": 11, "responses": { "red": 0.7 } },
        { "id": 12, "responses": { "red": 0.6, "green": 0.2 } }
      ],
      "expected": { "selected_id": 11, "score": 0.0, "excluded_candidate_ids": [] }
    },
    {
      "name": "all candidates missing active responses stay unmatched",
      "weights": { "blue": 1.0 },
      "target": { "blue": 0.4 },
      "candidates": [
        { "id": 21, "responses": { "red": 0.4 } },
        { "id": 22, "responses": { "green": 0.4 } }
      ],
      "expected": { "selected_id": null, "score": null, "excluded_candidate_ids": [21, 22] }
    }
  ]
}
