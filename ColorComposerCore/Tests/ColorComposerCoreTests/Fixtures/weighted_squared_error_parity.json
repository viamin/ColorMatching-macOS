{
  "source": "https://github.com/viamin/color_matching/pull/111",
  "description": "Bootstrap selection fixtures for ColorMatching.WeightedSquaredError. Replace this file with the upstream committed parity corpus verbatim when PR #111 is accessible.",
  "cases": [
    {
      "id": "nearest-red",
      "weights": { "red": 1.0 },
      "target": { "red": 0.2 },
      "candidates": [
        { "id": 1, "responses": { "red": 0.1 } },
        { "id": 2, "responses": { "red": 0.7 } }
      ],
      "expected": { "winner_id": 1, "score": 0.01 }
    },
    {
      "id": "weighted-channels-change-selection",
      "weights": { "red": 3.0, "green": 1.0 },
      "target": { "red": 0.0, "green": 0.0 },
      "candidates": [
        { "id": 10, "responses": { "red": 0.1, "green": 0.9 } },
        { "id": 11, "responses": { "red": 0.4, "green": 0.0 } }
      ],
      "expected": { "winner_id": 11, "score": 0.48 }
    },
    {
      "id": "zero-weight-missing-response-is-eligible",
      "weights": { "red": 1.0, "blue": 0.0 },
      "target": { "red": 0.5, "blue": 0.9 },
      "candidates": [
        { "id": 20, "responses": { "red": 0.5 } },
        { "id": 21, "responses": { "red": 0.7, "blue": 0.9 } }
      ],
      "expected": { "winner_id": 20, "score": 0.0 }
    },
    {
      "id": "missing-required-response-is-excluded",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "candidates": [
        { "id": 30, "responses": { "red": 0.5 } },
        { "id": 31, "responses": { "red": 0.6, "green": 0.5 } }
      ],
      "expected": { "winner_id": 31, "score": 0.01, "excluded_candidate_count": 1 }
    },
    {
      "id": "ties-preserve-palette-order",
      "weights": { "white": 1.0, "lps": 2.0 },
      "target": { "white": 0.5, "lps": 0.25 },
      "candidates": [
        { "id": 40, "responses": { "white": 0.4, "lps": 0.35 } },
        { "id": 41, "responses": { "white": 0.6, "lps": 0.15 } }
      ],
      "expected": { "winner_id": 40, "score": 0.03 }
    },
    {
      "id": "all-candidates-excluded",
      "weights": { "blue": 1.0 },
      "target": { "blue": 0.5 },
      "candidates": [
        { "id": 50, "responses": { "red": 0.5 } }
      ],
      "expected": { "winner_id": null, "score": null, "excluded_candidate_count": 1 }
    }
  ]
}
