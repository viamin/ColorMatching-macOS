    {
      "name": "zero_weight_missing_response_is_ignored",
      "weights": { "red": 1.0, "blue": 0.0 },
      "target": { "red": 0.4, "blue": 1.0 },
      "palette": [
        { "id": 301, "hex": "#333333", "responses": { "red": 0.4 } }
      ],
      "expected": { "selected_color_id": 301, "score": 0.0 }
