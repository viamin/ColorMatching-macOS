    {
      "name": "all_candidates_missing_an_active_response_are_unmatched",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "palette": [
        { "id": 501, "hex": "#ff0000", "responses": { "red": 0.5 } }
      ],
      "expected": { "selected_color_id": null }
    },
    {
      "name": "equal_scores_choose_the_first_palette_entry",
      "weights": { "red": 1.0 },
