{
  "format_version": 1,
  "solver": "weighted_squared_error",
  "source": "viamin/color_matching#111",
  "cases": [
    {
      "name": "selects the lowest weighted squared error across active channels",
      "weights": { "white": 0.5, "red": 1.0, "green": 1.0, "blue": 0.0, "lps": 1.5 },
      "target": { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.1, "lps": 0.5 },
      "candidates": [
        { "id": 101, "responses": { "white": 0.5, "red": 0.1, "green": 0.4, "blue": 0.0, "lps": 0.3 } },
        { "id": 102, "responses": { "white": 0.7, "red": 0.3, "green": 0.6, "blue": 1.0, "lps": 0.6 } }
      ],
      "expected": { "selected_color_id": 102, "score": 0.04, "excluded_color_ids": [] }
    },
    {
      "name": "ties select the earliest palette candidate",
      "weights": { "red": 1.0 },
      "target": { "red": 0.5 },
      "candidates": [
        { "id": 201, "responses": { "red": 0.4 } },
        { "id": 202, "responses": { "red": 0.6 } }
      ],
      "expected": { "selected_color_id": 201, "score": 0.009999999999999995, "excluded_color_ids": [] }
    },
    {
      "name": "zero weight channels neither score nor exclude candidates",
      "weights": { "white": 1.0, "green": 0.0 },
      "target": { "white": 0.8, "green": 0.2 },
      "candidates": [
        { "id": 301, "responses": { "white": 0.8 } },
        { "id": 302, "responses": { "white": 0.7, "green": 0.2 } }
      ],
      "expected": { "selected_color_id": 301, "score": 0.0, "excluded_color_ids": [] }
    },
    {
      "name": "candidates missing an active response are excluded",
      "weights": { "red": 1.0, "green": 2.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "candidates": [
        { "id": 401, "responses": { "red": 0.5 } },
        { "id": 402, "responses": { "red": 0.6, "green": 0.5 } }
      ],
      "expected": { "selected_color_id": 402, "score": 0.009999999999999995, "excluded_color_ids": [401] }
    },
    {
      "name": "all excluded candidates leave the target unmatched",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "candidates": [
        { "id": 501, "responses": { "red": 0.5 } },
        { "id": 502, "responses": { "green": 0.5 } }
      ],
      "expected": { "selected_color_id": null, "score": null, "excluded_color_ids": [501, 502] }
    }
  ]
}
