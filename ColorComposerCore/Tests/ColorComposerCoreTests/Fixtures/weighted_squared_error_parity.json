{
  "schema_version": 1,
  "upstream": "https://github.com/viamin/color_matching/pull/111",
  "algorithm": "WeightedSquaredError",
  "cases": [
    {
      "name": "weighted multi-channel selection",
      "weights": { "white": 0.5, "red": 1.0, "green": 1.0, "blue": 0.0, "lps": 1.5 },
      "target": { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.1, "lps": 0.5 },
      "candidates": [
        { "id": 1, "responses": { "white": 0.5, "red": 0.1, "green": 0.4, "blue": 0.0, "lps": 0.3 } },
        { "id": 2, "responses": { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.9, "lps": 0.5 } }
      ],
      "expected_candidate_id": 2
    },
    {
      "name": "ties select the earliest candidate",
      "weights": { "red": 1.0 },
      "target": { "red": 0.5 },
      "candidates": [
        { "id": 10, "responses": { "red": 0.4 } },
        { "id": 11, "responses": { "red": 0.6 } }
      ],
      "expected_candidate_id": 10
    },
    {
      "name": "missing required response is excluded",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "candidates": [
        { "id": 20, "responses": { "red": 0.5 } },
        { "id": 21, "responses": { "red": 0.5, "green": 0.7 } }
      ],
      "expected_candidate_id": 21
    },
    {
      "name": "zero weight ignores a missing response",
      "weights": { "red": 1.0, "blue": 0.0 },
      "target": { "red": 0.4, "blue": 1.0 },
      "candidates": [
        { "id": 30, "responses": { "red": 0.4 } },
        { "id": 31, "responses": { "red": 0.5, "blue": 1.0 } }
      ],
      "expected_candidate_id": 30
    },
    {
      "name": "channel weights change the selected candidate",
      "weights": { "red": 4.0, "green": 1.0 },
      "target": { "red": 0.0, "green": 0.0 },
      "candidates": [
        { "id": 40, "responses": { "red": 0.4, "green": 0.0 } },
        { "id": 41, "responses": { "red": 0.0, "green": 0.7 } }
      ],
      "expected_candidate_id": 41
    }
  ]
}
