{
  "source": "https://github.com/viamin/color_matching/pull/111",
  "schema_version": 1,
  "cases": [
    {
      "name": "weighted multi-channel selection",
      "weights": { "white": 0.5, "red": 1.0, "green": 1.0, "blue": 0.0, "lps": 1.5 },
      "target": { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.1, "lps": 0.5 },
      "palette": [
        { "id": 10, "hex": "#111111", "responses": { "white": 0.5, "red": 0.1, "green": 0.4, "blue": 0.0, "lps": 0.3 } },
        { "id": 20, "hex": "#eeeeee", "responses": { "white": 0.8, "red": 0.2, "green": 0.7, "blue": 0.1, "lps": 0.5 } }
      ],
      "expected": { "selected_palette_id": 20 }
    },
    {
      "name": "ties select the earliest palette entry",
      "weights": { "red": 1.0 },
      "target": { "red": 0.5 },
      "palette": [
        { "id": 30, "hex": "#333333", "responses": { "red": 0.5 } },
        { "id": 40, "hex": "#444444", "responses": { "red": 0.5 } }
      ],
      "expected": { "selected_palette_id": 30 }
    },
    {
      "name": "missing active response excludes a candidate",
      "weights": { "red": 1.0, "green": 2.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "palette": [
        { "id": 50, "hex": "#555555", "responses": { "red": 0.5 } },
        { "id": 60, "hex": "#666666", "responses": { "red": 0.5, "green": 0.5 } }
      ],
      "expected": { "selected_palette_id": 60 }
    },
    {
      "name": "zero-weight missing response does not exclude a candidate",
      "weights": { "red": 1.0, "blue": 0.0 },
      "target": { "red": 0.5 },
      "palette": [
        { "id": 70, "hex": "#777777", "responses": { "red": 0.5 } },
        { "id": 80, "hex": "#888888", "responses": { "red": 0.7, "blue": 0.5 } }
      ],
      "expected": { "selected_palette_id": 70 }
    },
    {
      "name": "all candidates excluded leaves the target unmatched",
      "weights": { "red": 1.0, "green": 1.0 },
      "target": { "red": 0.5, "green": 0.5 },
      "palette": [
        { "id": 90, "hex": "#999999", "responses": { "red": 0.5 } }
      ],
      "expected": { "selected_palette_id": null }
    }
  ]
}
