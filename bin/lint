#!/usr/bin/env bash
#
# Lint entry point, used by the pre-commit hook.
#
# This is a Swift project: there is no bundler or rubocop to run. SwiftLint is
# used when the repo opts into it (a .swiftlint.yml plus the tool installed);
# otherwise this falls back to a compiler parse check, so a commit is always
# verified without imposing unconfigured style rules on existing code.
#
# Usage: bin/lint [--staged]

set -euo pipefail

cd "$(dirname "$0")/.."

if [[ "${1:-}" == "--staged" ]]; then
  list_files() { git diff --cached --name-only --diff-filter=ACM -- '*.swift'; }
else
  list_files() { git ls-files -- '*.swift'; }
fi

# Read into an array without mapfile, which macOS's bash 3.2 lacks.
files=()
while IFS= read -r file; do
  [[ -n "$file" && -f "$file" ]] && files+=("$file")
done < <(list_files)

if [[ ${#files[@]} -eq 0 ]]; then
  echo "No Swift files to lint."
  exit 0
fi

if [[ -f .swiftlint.yml ]] && command -v swiftlint >/dev/null 2>&1; then
  echo "Running swiftlint on ${#files[@]} Swift file(s)..."
  swiftlint lint --strict --quiet "${files[@]}"
elif command -v swiftc >/dev/null 2>&1; then
  echo "Parse-checking ${#files[@]} Swift file(s)..."
  for file in "${files[@]}"; do
    swiftc -parse "$file" >/dev/null
  done
else
  echo "No Swift toolchain on PATH; skipping lint." >&2
fi
